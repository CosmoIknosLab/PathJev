# Cluster-wide Slurm settings. Copy to slurm/cluster.env, edit, then before submitting:
#   source slurm/cluster.env && sbatch slurm/campaigns/<job>.sbatch
# sbatch input environment variables override the #SBATCH directives in the scripts.
export SBATCH_ACCOUNT=your_account
export SBATCH_QOS=your_qos
# Where heavy outputs, raw datasets and the Python environment live (defaults in slurm/templates/common.sh).
export PATHJEV_WORK=$HOME/pathjev/work
export PATHJEV_DATA=$HOME/pathjev/data
export PATHJEV_VENV=$PWD/.venv
